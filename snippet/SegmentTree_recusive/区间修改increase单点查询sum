//区间修改increase单点查询sum,
//当出现需要对区间中所有数进行修改，而只需要单点查询，
//但是这个修改又无法同时作用于多个数时，如对区间上的数异或一个数
//注意这里多次操作是可以叠加的，但是无法对区间求出一个共同的变化，
//就如区间异或一个数后，无法从该区间节点求出新的区间和，因此不能进行区间查询，只能单点查询
//这时可以将区间操作缓存在非叶节点中，单点查询时，就将路径上的操作依次下推，直到叶节点

template<typename T>
struct SegmentTree
{
    const T UNUSED=0;
    int n;
    int nb;
    vector<T> vals;
    SegmentTree(int n)
    {
        this->n=n;
        int bit=(n-1==0 ? 0 : sizeof(int)*8U-__builtin_clz(n-1));
        nb=1<<bit;
        vals.assign(nb<<1,UNUSED);
    }
    SegmentTree(const vector<T> &a)
    {
        n=a.size();
        int bit=(n-1==0 ? 0 : sizeof(int)*8U-__builtin_clz(n-1));
        nb=1<<bit;
        vals.assign(nb<<1,UNUSED);
        build(a,1,0,n-1);
    }
    void build(const vector<T> &a,int idx,int l,int r)
    {
        if(l==r){
            vals[idx]=a[l];
            return;
        }
        int m=l+((r-l)>>1);
        build(a,idx*2,l,m);
        build(a,idx*2+1,m+1,r);
    }
    void apply(int idx, int l, int r, T todoval)
    {
        vals[idx]^=todoval;
    }
    void pushdown(int idx,int l,int r)
    {
        if(vals[idx]==UNUSED) return;
        int m=l+((r-l)>>1);
        apply(idx*2,    l,m,vals[idx]);
        apply(idx*2+1,m+1,r,vals[idx]);
        vals[idx]=UNUSED;
    }
    T query(int idx,int l,int r,int q)
    {
        if(q==l && q==r) return vals[idx];
        pushdown(idx,l,r);
        int m=l+((r-l)>>1);
        if(q<=m){
            return query(idx*2,    l,m,q);
        }else{
            return query(idx*2+1,m+1,r,q);
        }
    }
    T Query(int q)
    {
        return query(1,0,n-1,q);
    }
    void update(int idx,int l,int r,int ql,int qr,T todoval)
    {
        if(ql<=l && r<=qr){
            apply(idx,l,r,todoval);
            return;
        }
        pushdown(idx,l,r);
        int m=(l+r)>>1;
        if(ql<=m){
            update(idx*2  ,  l,m,ql,qr,todoval);
        }
        if(m<qr){
            update(idx*2+1,m+1,r,ql,qr,todoval);
        }
    }
    void Modify(int l,int r,T diff)
    {
        if(l>r) return;
        update(1,0,n-1,l,r,diff);
    }
};
