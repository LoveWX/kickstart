template<typename T>
struct SegmentTree
{
    const T UNUSED=0;
    int n;
    int nb;
    vector<T> vals;
    vector<T> todo;
    SegmentTree(int n)
    {
        this->n=n;
        int bit=(n-1==0 ? 0 : sizeof(int)*8U-__builtin_clz(n-1));
        nb=1<<bit;
        vals.assign(nb<<1,UNUSED);
        todo.assign(nb<<1,UNUSED);
    }
    SegmentTree(const vector<T> &a)
    {
        n=a.size();
        int bit=(n-1==0 ? 0 : sizeof(int)*8U-__builtin_clz(n-1));
        nb=1<<bit;
        vals.assign(nb<<1,UNUSED);
        todo.assign(nb<<1,UNUSED);
        build(a,1,0,n-1);
    }
    void build(const vector<T> &a,int idx,int l,int r)
    {
        if(l==r){
            vals[idx]=a[l];
            return;
        }
        int m=l+((r-l)>>1);
        build(a,idx*2,l,m);
        build(a,idx*2+1,m+1,r);
        pushup(idx);
    }
    void apply(int idx, int l, int r, T todoval)
    {
        vals[idx]+=todoval*(r-l+1);
        todo[idx]+=todoval;
    }
    void pushdown(int idx,int l,int r)
    {
        if(todo[idx]==UNUSED) return;
        int m=l+((r-l)>>1);
        apply(idx*2,    l,m,todo[idx]);
        apply(idx*2+1,m+1,r,todo[idx]);
        todo[idx]=UNUSED;
    }
    T query(int idx,int l,int r,int ql,int qr)
    {
        if(ql<=l && r<=qr) return vals[idx];
        pushdown(idx,l,r);
        int m=l+((r-l)>>1);
        if(qr<=m){
            return query(idx*2,    l,m,ql,qr);
        }
        if(m<ql){
            return query(idx*2+1,m+1,r,ql,qr);
        }
        T ansl=query(idx*2,    l,m,ql,qr);
        T ansr=query(idx*2+1,m+1,r,ql,qr);
        return ansl+ansr;
    }
    T Query(int ql,int qr)
    {
        if(ql>qr) return UNUSED;
        return query(1,0,n-1,ql,qr);
    }
    void pushup(int idx)
    {
        vals[idx]=vals[idx*2]+vals[idx*2+1];
    }
    void update(int idx,int l,int r,int ql,int qr,T todoval)
    {
        if(ql<=l && r<=qr){
            apply(idx,l,r,todoval);
            return;
        }
        pushdown(idx,l,r);
        int m=(l+r)>>1;
        if(ql<=m){
            update(idx*2  ,  l,m,ql,qr,todoval);
        }
        if(m<qr){
            update(idx*2+1,m+1,r,ql,qr,todoval);
        }
        pushup(idx);
    }
    void Modify(int l,int r,T diff)
    {
        if(l>r) return;
        update(1,0,n-1,l,r,diff);
    }
};
